# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API) — boss battles, pets, eggs, progress
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookies; any long random string, e.g. `openssl rand -base64 32`.
# Optional in development (a fixed dev secret is used), required in production.
SESSION_SECRET=

# Password reset emails, sent from a Gmail account: turn on 2-Step Verification,
# then create an app password at https://myaccount.google.com/apppasswords.
# Optional in development (emails are printed to the server console), required in production.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The site's address, for links in emails. Required in production.
APP_URL=http://localhost:3000

# Claude API key for sorting students' questions into groups (src/lib/ai).
# Optional: without it, simple rules group the questions instead.
ANTHROPIC_API_KEY=
