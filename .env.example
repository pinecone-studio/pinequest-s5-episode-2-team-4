# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API) — boss battles, pets, eggs, progress
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookies; any long random string, e.g. `openssl rand -base64 32`.
# Optional in development (a fixed dev secret is used), required in production.
SESSION_SECRET=

# Password reset emails, sent from a Gmail account: turn on 2-Step Verification,
# then create an app password at https://myaccount.google.com/apppasswords.
# Optional in development (emails are printed to the server console), required in production.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The site's address, for links in emails. Required in production.
APP_URL=http://localhost:3000

# Claude: sorts students' questions into groups and helps teachers (reading materials,
# reel scripts, game questions). Key at https://console.anthropic.com (set a spend limit there too).
# Optional: without it, simple rules group the questions and teacher pages use demo content.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Monthly cap in dollars for the teacher tools, counted in the ai_usage table; past it they use demo content.
AI_MONTHLY_BUDGET_USD=1

# ElevenLabs, for the Mongolian narration of lesson reels (elevenlabs.io → API Keys; Voices → voice ID).
# Mongolian needs eleven_v3 or newer; eleven_v4 is the best quality. Optional: without it reels play as silent timed captions.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
